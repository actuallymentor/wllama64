{
  "author": "Xuan Son NGUYEN <contact@ngxson.com>",
  "keywords": [
    "wasm",
    "webassembly",
    "llama",
    "llm",
    "ai",
    "rag",
    "embeddings",
    "generation"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/actuallymentor/wllama64/issues"
  },
  "description": "Memory64 WebAssembly binding for llama.cpp - Enabling on-browser LLM inference",
  "directories": {
    "example": "examples"
  },
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./esm/index.cjs",
      "default": "./esm/index.js"
    },
    "./wasm/wllama.wasm": "./esm/wasm/wllama.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "esm",
    "assets",
    "CHANGELOG.md",
    "LICENCE",
    "README.md",
    "README_banner.png"
  ],
  "homepage": "https://github.com/actuallymentor/wllama64#readme",
  "main": "./esm/index.cjs",
  "module": "./esm/index.js",
  "name": "wllama64",
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "bracketSameLine": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actuallymentor/wllama64.git"
  },
  "type": "module",
  "types": "./esm/index.d.ts",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/browser": "^2.1.6",
    "express": "^4.18.3",
    "mime-types": "^2.1.35",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "terser": "^5.39.0",
    "tsup": "^8.4.0",
    "typedoc": "^0.27.2",
    "typescript": "^5.4.2",
    "webdriverio": "^9.4.1"
  },
  "scripts": {
    "build": "npm run clean && npm run build:worker && npm run build:tsup && npm run build:minified && npm run build:typedef && ./scripts/post_build.sh && npm run docs",
    "build:glue": "node ./cpp/generate_glue_prototype.js",
    "build:minified": "terser esm/index.js -o esm/index.min.js --compress --mangle --source-map",
    "build:test": "WLLAMA_TEST_BACKEND=1 npm run build:wasm",
    "build:tsup": "tsup src/index.ts --format cjs,esm --clean",
    "build:typedef": "tsc --emitDeclarationOnly --declaration -p tsconfig.build.json",
    "build:wasm": "./scripts/build_wasm.sh && npm run build:glue",
    "build:worker": "./scripts/build_worker.sh",
    "check:package": "node scripts/check_package_size.js && node scripts/check_package_exports.mjs",
    "check:release-automation": "node --test scripts/prepare_upstream_release.test.mjs",
    "check:wasm": "node scripts/check_wasm_memory.mjs",
    "clean": "rm -rf ./esm && rm -rf ./docs && rm -rf ./wasm",
    "docs": "typedoc --tsconfig tsconfig.build.json src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "npm run build && npm run format:check && npm run check:wasm && npm run check:package",
    "serve": "node ./scripts/http_server.js",
    "serve:mt": "MULTITHREAD=1 node ./scripts/http_server.js",
    "test": "vitest",
    "test:auto": "AUTO=1 vitest",
    "test:compat": "AUTO=1 COMPAT=1 vitest src/wllama.compat.test.ts",
    "test:firefox": "AUTO=1 BROWSER=firefox vitest",
    "test:memory64": "AUTO=1 vitest src/memory64.test.ts",
    "test:memory64:stress": "npm run test:memory64:stress:unit && npm run build:worker && npm run build:tsup && npm run build:minified && ./scripts/post_build.sh && node scripts/memory64_stress.mjs",
    "test:memory64:stress:low-memory": "WLLAMA_STRESS_TWO_PHASE=1 WLLAMA_STRESS_CASES=8g,12g npm run test:memory64:stress",
    "test:memory64:stress:multithread": "WLLAMA_STRESS_THREADS=2 WLLAMA_STRESS_CASES=8g npm run test:memory64:stress",
    "test:memory64:stress:smoke": "WLLAMA_STRESS_CASES=tiny npm run test:memory64:stress",
    "test:memory64:stress:unit": "node --test scripts/memory64_stress.test.mjs",
    "test:safari": "BROWSER=safari vitest",
    "test:wgpu": "WEBGPU=1 vitest"
  },
  "version": "1.0.1",
  "wllama64": {
    "upstreamPackage": "@wllama/wllama",
    "upstreamVersion": "3.6.1",
    "upstreamCommit": "e3972797f9d508887440e9d3fa87dc296f2dec44",
    "upstreamRepository": "https://github.com/ngxson/wllama",
    "compatPackage": "@wllama/wllama-compat",
    "compatVersion": "3.6.1"
  }
}
